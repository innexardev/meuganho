<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MeuGanho" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mg_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash nativa (Android 12+) com retrocompatibilidade via core-splashscreen. -->
    <style name="Theme.MeuGanho.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mg_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MeuGanho</item>
    </style>
</resources>
